# Docker builds from the project root (docker build -f docker/Dockerfile .),
# so this file must live in the project root to take effect.

# Secrets: pass API keys at run time instead (docker run --env-file .env ...)
.env

# Not needed inside the image
.git/
.github/
.vscode/
.venv/
**/__pycache__/
**/*.pyc

# Saved jobs, logs, resumes and test output belong to each machine, not the image
# (resumes hold personal details; docker-compose.yml mounts the folder instead).
# The one exception is the sample resume, so the app can be tried straight away
data/
logs/
resumes/*
!resumes/sample_resume_fintech.docx
results/
output_results/
tests/
handoff.md
