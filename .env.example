# Copy to .env and fill in your Google Gemini API key (never commit .env)
# AI_PROVIDER=gemini   (the only provider)
# AI_MODEL=
GEMINI_API_KEY=
# Saved jobs are kept in PostgreSQL. Without DATABASE_URL the app uses the default below (a local database on port 5432)
# docker compose reads POSTGRES_PASSWORD (default: jobmatcher) for the db service and builds DATABASE_URL for web itself
# POSTGRES_PASSWORD=jobmatcher
# DATABASE_URL=postgresql://jobmatcher:jobmatcher@localhost:5432/jobmatcher
# Optional: every record goes to the live AI by default. AI_CACHE=on saves and replays AI replies instead, so a run
# repeats exactly and a demo can replay an earlier run with no network (a fallback, not the normal mode)
# AI_CACHE=on
# AI_CACHE_PATH=data/ai_cache.json
# Optional: the last listings of each job search, used when MyCareersFuture can't be reached
# PORTAL_LISTINGS_PATH=data/portal_listings.json
